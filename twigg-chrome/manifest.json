{
  "manifest_version": 3,
  "name": "Twigg Links",
  "description": "Type go/alias, b/123 or c/123 in the address bar to open your Twigg repo's go links, bugs and commits.",
  "version": "0.0.1",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "links@twigg.vc",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "homepage_url": "https://twigg.vc",
  "icons": {
    "128": "icons/twigg.png"
  },
  "action": {
    "default_title": "Twigg Links",
    "default_popup": "options.html",
    "default_icon": {
      "128": "icons/twigg.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js",
    "type": "module"
  },
  "omnibox": {
    "keyword": "go"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "*://go/*",
    "*://b/*",
    "*://c/*",
    "https://www.google.com/*",
    "https://www.bing.com/*",
    "https://duckduckgo.com/*"
  ]
}
