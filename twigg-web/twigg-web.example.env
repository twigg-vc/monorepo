# Base64-encoded 32-byte AES-256 key. Generate with: openssl rand -base64 32
TWIGG_MASTER_KEY=

# Key the CICD servers uses to communicate with this server
TWIGG_SERVER_KEY=

# Key used to authenticate to the track (CICD) server.
# Must match twigg-track's TWIGG_TRACK_KEY.
TWIGG_TRACK_KEY=

# Key used to sign and verify twigg auth tokens
TWIGG_TOKEN_SIGNING_KEY=

# DigitalOcean Spaces credentials
TWIGG_DO_SPACES_ACCESS_KEY_ID=
TWIGG_DO_SPACES_ACCESS_KEY_SECRET=

# Stripe
TWIGG_STRIPE_SECRET_KEY=
TWIGG_STRIPE_ENDPOINT_SECRET=

# Google OAuth
TWIGG_GOOGLE_CLIENT_ID=
TWIGG_GOOGLE_CLIENT_SECRET=

# Microsoft Azure OAuth
TWIGG_MS_AZURE_CLIENT_ID=
TWIGG_MS_AZURE_CLIENT_SECRET=

# Salt used when hashing passwords and CLI keys
TWIGG_PASSWORD_SALT=
